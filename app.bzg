include("lib/http.bzg");

var server = http(8000);

// HTTP ROUTING
server.get = function (path, data) {
    print("GET request: " + path);

    if (path == "/") {
        server.sendFile("public/index.html");
    } 
    else if (path == "/player.png") {
        server.sendFile("public/player.png");
    } 
    else if (path == "/lumbridge.png") {
        server.sendFile("public/lumbridge.png");
    } 
    else if (path == "/varrock.png") {
        server.sendFile("public/varrock.png");
    } 
    else {
        server.sendFile("public/404.html");
    }
};

// WEBSOCKET HANDLERS
server.onConnect = function (clientId) {
    print("Adventurer connected! Client ID: " + clientId);
    server.send(clientId, "SYSTEM:WELCOME:" + clientId);
};

server.onData = function (message, clientId) {
    print("Payload from Adventurer " + clientId + ": " + message);
    server.sendAll(message);
};

server.onDisconnect = function (clientId) {
    print("Adventurer disconnected! Client ID: " + clientId);
    server.sendAll("LEAVE:" + clientId);
};

print("OSRS WebSocket Server running on port 8000...");
server.run();